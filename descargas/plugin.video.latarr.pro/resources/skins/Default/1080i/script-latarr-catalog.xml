<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">8100</defaultcontrol>
    
    <controls>
        <!-- 1. Fondo base obsidiana -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF0D0F14">button_focus.png</texture>
        </control>

        <!-- Fanart oficial de Latarr como fondo estático (sin descargas de red) -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <aspectratio>scale</aspectratio>
            <colordiffuse>33FFFFFF</colordiffuse>
            <texture>fanart_bg.jpg</texture>
        </control>

        <!-- Viñeta degradada Apple TV oscura -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>vignette_hero.png</texture>
            <aspectratio>stretch</aspectratio>
        </control>

        <!-- Franja oscura de cabecera estilo vidrio Apple TV para contraste total -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>136</height>
            <texture colordiffuse="E80B0E14">button_focus.png</texture>
        </control>

        <!-- 2. Barra Superior de Título y Filtros -->
        <control type="label">
            <left>70</left>
            <top>30</top>
            <width>340</width>
            <height>42</height>
            <font>font30_title</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>FF000000</shadowcolor>
            <label>$INFO[Window.Property(catalog_title)]</label>
        </control>

        <control type="grouplist" id="8000">
            <left>420</left>
            <top>30</top>
            <width>1430</width>
            <height>44</height>
            <orientation>horizontal</orientation>
            <itemgap>14</itemgap>
            <ondown>8100</ondown>

            <!-- Filtro Año -->
            <control type="button" id="8001">
                <width>180</width>
                <height>42</height>
                <label>Año: $INFO[Window.Property(filter_year)]</label>
                <font>font12</font>
                <align>center</align>
                <textcolor>FFD0D4DC</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus border="12">button_focus.png</texturefocus>
                <texturenofocus border="12">button_normal.png</texturenofocus>
                <ondown>8100</ondown>
            </control>

            <!-- Filtro Género -->
            <control type="button" id="8002">
                <width>260</width>
                <height>42</height>
                <label>Género: $INFO[Window.Property(filter_genre)]</label>
                <font>font12</font>
                <align>center</align>
                <textcolor>FFD0D4DC</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus border="12">button_focus.png</texturefocus>
                <texturenofocus border="12">button_normal.png</texturenofocus>
                <ondown>8100</ondown>
            </control>

            <!-- Botón Volver a Inicio -->
            <control type="button" id="8005">
                <width>140</width>
                <height>42</height>
                <label>Volver a Inicio</label>
                <font>font12</font>
                <align>center</align>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus border="12">button_focus.png</texturefocus>
                <texturenofocus border="12">button_normal.png</texturenofocus>
                <ondown>8100</ondown>
            </control>
        </control>

        <!-- 3. Sub-barra de Info Rápida -->
        <!-- Información del título enfocado -->
        <control type="label">
            <left>70</left>
            <top>88</top>
            <width>1280</width>
            <height>32</height>
            <font>font13</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>FF000000</shadowcolor>
            <label>$INFO[Window.Property(selected_title)] [COLOR FFD0D4DC]($INFO[Window.Property(selected_year)])[/COLOR]  •  [COLOR FFFFD60A]★ $INFO[Window.Property(selected_rating)][/COLOR]  •  [COLOR FFD0D4DC]$INFO[Window.Property(selected_genre)][/COLOR]</label>
        </control>

        <!-- Píldora de Paginación en Alto Contraste -->
        <control type="group">
            <left>1370</left>
            <top>86</top>
            <width>480</width>
            <height>32</height>
            <control type="image">
                <left>0</left><top>0</top><width>480</width><height>32</height>
                <texture border="8">badge_bg.png</texture>
            </control>
            <control type="label">
                <left>10</left><top>0</top><width>460</width><height>32</height>
                <font>font12</font>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>FFFFFFFF</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window.Property(total_count)] títulos disponibles</label>
            </control>
        </control>

        <!-- Separador sutil -->
        <control type="image">
            <left>70</left>
            <top>132</top>
            <width>1780</width>
            <height>1</height>
            <texture colordiffuse="33FFFFFF">button_focus.png</texture>
        </control>

        <!-- 4. Cuadrícula de Pósters (Apple TV Poster Wall) -->
        <control type="panel" id="8100">
            <left>70</left>
            <top>145</top>
            <width>1780</width>
            <height>900</height>
            <orientation>vertical</orientation>
            <scrolltime>200</scrolltime>
            <onup>8001</onup>
            <pagecontrol>60</pagecontrol>

            <itemlayout width="254" height="355">
                <control type="image">
                    <left>15</left>
                    <top>0</top>
                    <width>224</width>
                    <height>336</height>
                    <aspectratio scalediffuse="false">scale</aspectratio>
                    <diffuse>mask_poster.png</diffuse>
                    <texture fallback="fallback_poster.png">$INFO[ListItem.Art(poster)]</texture>
                </control>
            </itemlayout>

            <focusedlayout width="254" height="355">
                <control type="image">
                    <left>15</left>
                    <top>0</top>
                    <width>224</width>
                    <height>336</height>
                    <aspectratio scalediffuse="false">scale</aspectratio>
                    <diffuse>mask_poster.png</diffuse>
                    <texture fallback="fallback_poster.png">$INFO[ListItem.Art(poster)]</texture>
                </control>
                <!-- Marco blanco brillante con halo neón sobre el póster seleccionado -->
                <control type="image">
                    <left>2</left>
                    <top>-13</top>
                    <width>250</width>
                    <height>362</height>
                    <texture border="24">frame_focus.png</texture>
                    <visible>Control.HasFocus(8100)</visible>
                </control>
            </focusedlayout>
        </control>

    </controls>
</window>
