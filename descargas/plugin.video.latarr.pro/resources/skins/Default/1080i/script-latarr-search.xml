<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">7001</defaultcontrol>
    
    <controls>
        <!-- Fondo oscurecido con desenfoque simulado (Backdrop Dimmer) -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="D9000000">button_focus.png</texture>
        </control>

        <!-- Tarjeta Flotante Central de Búsqueda (Glass Sheet) -->
        <control type="group">
            <left>360</left>
            <top>140</top>
            <width>1200</width>
            <height>800</height>

            <!-- Fondo de la tarjeta con borde sutil -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1200</width>
                <height>800</height>
                <texture border="16">button_normal.png</texture>
                <colordiffuse>F212151C</colordiffuse>
            </control>

            <!-- Borde exterior fino de elevación -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1200</width>
                <height>800</height>
                <texture border="16">border_glow.png</texture>
                <colordiffuse>33FFFFFF</colordiffuse>
            </control>

            <!-- Título del diálogo -->
            <control type="label">
                <left>50</left>
                <top>35</top>
                <width>1100</width>
                <height>40</height>
                <font>font30_title</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Window.Property(dialog_title)]</label>
            </control>

            <!-- Subtítulo / Info de búsqueda -->
            <control type="label">
                <left>50</left>
                <top>80</top>
                <width>1100</width>
                <height>25</height>
                <font>font13</font>
                <textcolor>FF8E95A5</textcolor>
                <label>$INFO[Window.Property(dialog_subtitle)]</label>
            </control>

            <!-- Separador sutil -->
            <control type="image">
                <left>50</left>
                <top>115</top>
                <width>1100</width>
                <height>1</height>
                <texture colordiffuse="26FFFFFF">button_focus.png</texture>
            </control>

            <!-- Lista de Resultados -->
            <control type="list" id="7001">
                <left>50</left>
                <top>130</top>
                <width>1100</width>
                <height>570</height>
                <onup>7001</onup>
                <ondown>7002</ondown>
                <pagecontrol>60</pagecontrol>

                <itemlayout height="95" width="1100">
                    <control type="image">
                        <left>0</left>
                        <top>3</top>
                        <width>1100</width>
                        <height>89</height>
                        <texture border="12">button_normal.png</texture>
                        <colordiffuse>801E222B</colordiffuse>
                    </control>
                    <!-- Mini póster ampliado -->
                    <control type="image">
                        <left>12</left>
                        <top>7</top>
                        <width>54</width>
                        <height>81</height>
                        <aspectratio>scale</aspectratio>
                        <texture fallback="fallback_poster.png">$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <!-- Título -->
                    <control type="label">
                        <left>82</left>
                        <top>16</top>
                        <width>640</width>
                        <height>28</height>
                        <font>font14</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <!-- Metadatos -->
                    <control type="label">
                        <left>82</left>
                        <top>50</top>
                        <width>640</width>
                        <height>22</height>
                        <font>font12</font>
                        <textcolor>FF8E95A5</textcolor>
                        <label>$INFO[ListItem.Property(details)]</label>
                    </control>
                    <!-- Tipo con Emoji y Rating -->
                    <control type="label">
                        <left>730</left>
                        <top>28</top>
                        <width>345</width>
                        <height>35</height>
                        <font>font13</font>
                        <align>right</align>
                        <textcolor>FFFFD60A</textcolor>
                        <label>$INFO[ListItem.Property(badge)]</label>
                    </control>
                </itemlayout>

                <focusedlayout height="95" width="1100">
                    <!-- Fondo enfocado blanco puro Apple TV -->
                    <control type="image">
                        <left>0</left>
                        <top>3</top>
                        <width>1100</width>
                        <height>89</height>
                        <texture border="12">button_focus.png</texture>
                    </control>
                    <!-- Mini póster ampliado -->
                    <control type="image">
                        <left>12</left>
                        <top>7</top>
                        <width>54</width>
                        <height>81</height>
                        <aspectratio>scale</aspectratio>
                        <texture fallback="fallback_poster.png">$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <!-- Título en negro de alto contraste -->
                    <control type="label">
                        <left>82</left>
                        <top>16</top>
                        <width>640</width>
                        <height>28</height>
                        <font>font14</font>
                        <textcolor>FF000000</textcolor>
                        <label>[B]$INFO[ListItem.Label][/B]</label>
                    </control>
                    <!-- Metadatos en gris oscuro legible -->
                    <control type="label">
                        <left>82</left>
                        <top>50</top>
                        <width>640</width>
                        <height>22</height>
                        <font>font12</font>
                        <textcolor>FF333333</textcolor>
                        <label>$INFO[ListItem.Property(details)]</label>
                    </control>
                    <!-- Tipo con Emoji y Rating -->
                    <control type="label">
                        <left>730</left>
                        <top>28</top>
                        <width>345</width>
                        <height>35</height>
                        <font>font13</font>
                        <align>right</align>
                        <textcolor>FF000000</textcolor>
                        <label>[B]$INFO[ListItem.Property(badge)][/B]</label>
                    </control>
                </focusedlayout>
            </control>

            <!-- Botón Volver al Menú Principal -->
            <control type="button" id="7002">
                <left>450</left>
                <top>725</top>
                <width>300</width>
                <height>45</height>
                <font>font13</font>
                <align>center</align>
                <label>Volver a Inicio</label>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus border="12">button_focus.png</texturefocus>
                <texturenofocus border="12">button_normal.png</texturenofocus>
                <onup>7001</onup>
                <ondown>7001</ondown>
            </control>

        </control>
    </controls>
</window>
