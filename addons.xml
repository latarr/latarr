<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.latarr.pro" name="LATARR PRO" version="2.0.0" provider-name="Oscar">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <!-- Emuladores Retro Arcade (opcionales - Kodi los instala al primer uso) -->
        <import addon="game.libretro.fbneo"            version="0.0.0" optional="true"/>
        <import addon="game.libretro.snes9x"           version="0.0.0" optional="true"/>
        <import addon="game.libretro.genesis-plus-gx"  version="0.0.0" optional="true"/>
        <import addon="game.libretro.fceumm"           version="0.0.0" optional="true"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="es_ES">LATARR PRO - Cine y Deporte Premium</summary>
        <description lang="es_ES">LATARR PRO - Versión familiar privada con deportes premium, películas, series y anime.</description>
        <disclaimer lang="es_ES">Este plugin requiere que la API de Latarr esté funcionando.</disclaimer>
        <language></language>
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <forum></forum>
        <website></website>
        <email></email>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="repository.latarr" name="LATARR PRO Repository" version="2.0.1" provider-name="Oscar">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="LATARR PRO Repository">
        <dir>
            <info compressed="false">https://latarr-pro.pages.dev/addons.xml</info>
            <checksum>https://latarr-pro.pages.dev/addons.xml.md5</checksum>
            <datadir zip="true">https://latarr-pro.pages.dev/descargas/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Repositorio Privado LATARR PRO</summary>
        <description>Repositorio privado familiar. Descarga e instala LATARR PRO con deportes premium.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
</addons>
