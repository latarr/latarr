<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.latarr" name="Latarr" version="2.0.0" provider-name="Oscar">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="es_ES">Latarr - Tu Cine Retro</summary>
        <description lang="es_ES">Acceso directo a Latarr API con interfaz Apple TV Cinema. Películas, Series y Anime de alta calidad.</description>
        <disclaimer lang="es_ES">Este plugin requiere que la API de Latarr esté funcionando.</disclaimer>
        <language></language>
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <forum></forum>
        <website></website>
        <email></email>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="repository.latarr" name="Latarr Repository" version="2.0.1" provider-name="Oscar">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Latarr Repository">
        <dir>
            <info compressed="false">https://latarr.github.io/latarr/addons.xml</info>
            <checksum>https://latarr.github.io/latarr/addons.xml.md5</checksum>
            <datadir zip="true">https://latarr.github.io/latarr/descargas/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Repositorio Oficial de Latarr</summary>
        <description>Descarga y mantén actualizado el Add-on de Latarr. Servido desde GitHub Pages.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
</addons>
